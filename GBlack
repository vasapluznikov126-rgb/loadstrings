local function playIdleForCurrentMode()
    if not Humanoid or stopAnimationSystem or scriptLocked then return end

    if currentIdleTrack then
        currentIdleTrack:Stop()
        currentIdleTrack:Destroy()
        currentIdleTrack = nil
    end

    local idleAnimId = (currentScytheMode == "knives") and idleAnimKnives or idleAnimNormal
    local idleAnim = Instance.new("Animation")
    idleAnim.AnimationId = idleAnimId
    local idleTrack = Humanoid:LoadAnimation(idleAnim)
    idleTrack.Priority = Enum.AnimationPriority.Idle
    idleTrack.Looped = true
    idleTrack:Play()
    currentIdleTrack = idleTrack
end

local function playPhase2Idle()
    if not Humanoid or scriptLocked then return end
    for _, track in ipairs(Humanoid:GetPlayingAnimationTracks()) do
        track:Stop(0)
        track:Destroy()
    end
    local anim = Instance.new("Animation")
    anim.AnimationId = idlePhase2
    local track = Humanoid:LoadAnimation(anim)
    track.Priority = Enum.AnimationPriority.Idle
    track.Looped = true
    track:Play()
    currentIdleTrack = track
end

local function playLockedActionAnimation()
    if not scriptRunning or stopAnimationSystem or scriptLocked then return end
    if not Humanoid or not actionAnimTrack then return end
    if dataFolder and dataFolder:FindFirstChild("Health") and dataFolder.Health.Value == 0 then
        stopAnimationSystem = true
        return
    end

    animationLocked = true

    for _, track in ipairs(Humanoid:GetPlayingAnimationTracks()) do
        if track ~= actionAnimTrack then
            track:Stop(0)
        end
    end

    actionAnimTrack:Stop(0)
    actionAnimTrack:Play(0.05, 1, 1.5)

    if not actionAnimTrack:GetAttribute("LockHooked") then
        actionAnimTrack:SetAttribute("LockHooked", true)

        Humanoid.AnimationPlayed:Connect(function(track)
            if animationLocked and track ~= actionAnimTrack then
                track:Stop(0)
            end
        end)

        actionAnimTrack.Stopped:Connect(function()
            animationLocked = false
            task.wait(0.1)
            playIdleForCurrentMode()
        end)
    end
end

local function playDeathAnimation()
    if not Humanoid or scriptLocked then return end

    disableAnimate()

    for _, track in ipairs(Humanoid:GetPlayingAnimationTracks()) do
        track:Stop(0)
        track:Destroy()
    end

    local anim = Instance.new("Animation")
    anim.AnimationId = deathAnimId
    local track = Humanoid:LoadAnimation(anim)
    track.Priority = Enum.AnimationPriority.Core
    track:Play()
    track:AdjustSpeed(0.8)

    local conn
    conn = Humanoid.AnimationPlayed:Connect(function(newTrack)
        if newTrack ~= track then
            newTrack:Stop(0)
            newTrack:Destroy()
        end
    end)

    local timeoutTask = task.delay(30, function()
        if scytheSystemEnabled then
            conn:Disconnect()
            playPhase2Idle()
            disableScytheSystem()
        end
    end)

    track.Stopped:Connect(function()
        conn:Disconnect()
        if timeoutTask then task.cancel(timeoutTask) end
        playPhase2Idle()
        disableScytheSystem()
    end)
end

local modeSwitchCooldown = false
local modeSwitchTimer = nil

local function switchScytheMode()
    if not scriptRunning or not scytheSystemEnabled or stopAnimationSystem or scriptLocked then return end
    if isSecondPhaseActive() then return end
    if modeSwitchCooldown then return end

    if pendingFinalTimer then
        task.cancel(pendingFinalTimer)
        pendingFinalTimer = nil
    end
    if pendingFinalSwing then
        pendingFinalSwing = false
        m1PressCount = 0
        canUseM1 = true
    end

    local cooldownTime = 0
    if not scytheInstance then
        currentScytheMode = "knives"
        loadScythe()
        task.spawn(playLockedActionAnimation)
        cooldownTime = 0.85  -- Normal -> Knives
    else
        if currentScytheMode == "knives" then
            -- knives -> normal
            currentScytheMode = "normal"
            destroyScythe()
            playIdleForCurrentMode()
            cooldownTime = 0.85 -- Knives -> Normal
        else
            -- normal -> knives
            currentScytheMode = "knives"
            loadScythe()
            task.spawn(playLockedActionAnimation)
            cooldownTime = 0.85  -- Normal -> Knives
        end
    end

    if cooldownTime > 0 then
        modeSwitchCooldown = true
        if modeSwitchTimer then task.cancel(modeSwitchTimer) end
        modeSwitchTimer = task.delay(cooldownTime, function()
            modeSwitchCooldown = false
            modeSwitchTimer = nil
        end)
    end
end

local function startHealthMonitor()
    while scriptRunning and not scriptLocked do
        task.wait(0.1)
        if stopAnimationSystem then break end
        if not character or not dataFolder then break end
        local health = dataFolder:FindFirstChild("Health")
        if health then
            if health.Value == 0 then
                if not stopAnimationSystem then
                    stopAnimationSystem = true
                    destroyScythe()
                    if currentIdleTrack then
                        currentIdleTrack:Stop()
                        currentIdleTrack:Destroy()
                        currentIdleTrack = nil
                    end
                    if actionAnimTrack then
                        actionAnimTrack:Stop()
                    end
                    if Humanoid then
                        for _, track in ipairs(Humanoid:GetPlayingAnimationTracks()) do
                            track:Stop(0)
                            track:Destroy()
                        end
                    end
                    playDeathAnimation()
                end
                break
            end
        end
        local secondPhase = dataFolder:FindFirstChild("SecondPhase")
        if secondPhase and secondPhase.Value == true then
            if not stopAnimationSystem then
                stopAnimationSystem = true
                destroyScythe()
                if currentIdleTrack then
                    currentIdleTrack:Stop()
                    currentIdleTrack:Destroy()
                    currentIdleTrack = nil
                end
                if actionAnimTrack then
                    actionAnimTrack:Stop()
                end
                if Humanoid then
                    for _, track in ipairs(Humanoid:GetPlayingAnimationTracks()) do
                        track:Stop(0)
                        track:Destroy()
                    end
                end
                playDeathAnimation()
            end
            break
        end
    end
end


