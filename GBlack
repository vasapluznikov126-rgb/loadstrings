local function canPlaySound()
    if not scriptRunning or not character or not dataFolder or scriptLocked then return false end
    if not scytheSystemEnabled or stopAnimationSystem then return false end
    local frozen = dataFolder:FindFirstChild("Frozen")
    local blocking = dataFolder:FindFirstChild("Blocking")
    local stunned = dataFolder:FindFirstChild("Stunned")
    if not frozen or not blocking or not stunned then return false end
    return (frozen.Value == false and blocking.Value == false and stunned.Value == false)
end

local function isSecondPhaseActive()
    if not scriptRunning or not character or not dataFolder or scriptLocked then return false end
    local health = dataFolder:FindFirstChild("Health")
    if health and health.Value <= 0.1 then
        local secondPhase = dataFolder:FindFirstChild("SecondPhase")
        if secondPhase then secondPhase.Value = true end
        return true
    end
    local secondPhase = dataFolder:FindFirstChild("SecondPhase")
    return (secondPhase and secondPhase.Value == true)
end

local function playSoundAtCharacter(soundId)
    if not scriptRunning or not character or scriptLocked then return nil end
    if not canPlaySound() or not soundId then return nil end
    local soundParent = character:FindFirstChild("Head") or character:FindFirstChild("UpperTorso") or character:FindFirstChild("HumanoidRootPart") or character
    if not soundParent then return nil end
    for _, oldSound in ipairs(soundParent:GetChildren()) do
        if oldSound:IsA("Sound") and (oldSound.Name == "M1SwingSound" or oldSound.Name == "M1KnivesSound") then
            oldSound:Stop()
            oldSound:Destroy()
        end
    end
    local sound = Instance.new("Sound")
    sound.Name = "M1SwingSound"
    sound.SoundId = soundId
    sound.Volume = 5
    sound.Parent = soundParent
    sound:Play()
    sound.Ended:Connect(function() sound:Destroy() end)
    game:GetService("Debris"):AddItem(sound, 5)
    return sound
end

local function playRandomNormalSound()
    if #NormalSwingSounds == 0 then return nil end
    return NormalSwingSounds[math.random(1, #NormalSwingSounds)]
end

local function resetM1Counter()
    m1PressCount = 0
end

local function startM1Cooldown()
    if cooldownTask then task.cancel(cooldownTask) end
    canUseM1 = false
    cooldownTask = task.delay(M1_COOLDOWN, function()
        if not scriptRunning or scriptLocked then return end
        canUseM1 = true
        m1PressCount = 0
        cooldownTask = nil
    end)
end

local function startTimeoutReset()
    if timeoutTask then task.cancel(timeoutTask) end
    timeoutTask = task.delay(TIMEOUT_DURATION, function()
        if not scriptRunning or scriptLocked then return end
        if m1PressCount > 0 and m1PressCount < M1_PRESS_LIMIT then
            resetM1Counter()
        end
        timeoutTask = nil
    end)
end

local function startSwingCooldown()
    if swingCooldownTask then task.cancel(swingCooldownTask) end
    canUseM1 = false
    swingCooldownTask = task.delay(M1_COOLDOWN_NEW, function()
        if not scriptRunning or scriptLocked then return end
        canUseM1 = true
        swingCooldownTask = nil
    end)
end

local function executeFinalSwing()
    if not scriptRunning or not scytheSystemEnabled or stopAnimationSystem or scriptLocked then return end

    if currentScytheMode == "knives" then
        playSoundAtCharacter(LastM1SoundId)
    else
        local randomSoundId = playRandomNormalSound()
        if randomSoundId then playSoundAtCharacter(randomSoundId) end
    end

    startM1Cooldown()
end

local function tryExecutePendingFinal()
    if not pendingFinalSwing then return false end
    if not canPlaySound() then return false end

    pendingFinalSwing = false
    if pendingFinalTimer then
        task.cancel(pendingFinalTimer)
        pendingFinalTimer = nil
    end
    executeFinalSwing()
    return true
end

local function handleM1Action()
    if not scriptRunning or not canUseM1 or not scytheSystemEnabled or stopAnimationSystem or scriptLocked then return false end

    local currentTime = tick()

    if pendingFinalSwing then
        return false
    end

    if m1PressCount > 0 and (currentTime - lastM1PressTime) > TIMEOUT_DURATION then
        resetM1Counter()
    end

    lastM1PressTime = currentTime
    m1PressCount = m1PressCount + 1

    if m1PressCount >= M1_PRESS_LIMIT then
        if canPlaySound() then
            if currentScytheMode == "knives" then
                playSoundAtCharacter(LastM1SoundId)
            else
                local randomSoundId = playRandomNormalSound()
                if randomSoundId then playSoundAtCharacter(randomSoundId) end
            end
            startM1Cooldown()
        else
            pendingFinalSwing = true
            canUseM1 = false
            pendingFinalTimer = task.delay(PENDING_TIMEOUT, function()
                if pendingFinalSwing then
                    pendingFinalSwing = false
                    pendingFinalTimer = nil
                    m1PressCount = 0
                    canUseM1 = true
                end
            end)
            task.spawn(function()
                while pendingFinalSwing and scriptRunning and not scriptLocked do
                    task.wait(0.1)
                    if tryExecutePendingFinal() then
                        break
                    end
                end
            end)
        end
    else
        if canPlaySound() then
            if currentScytheMode == "knives" then
                playSoundAtCharacter(M1SoundId)
            else
                local randomSoundId = playRandomNormalSound()
                if randomSoundId then playSoundAtCharacter(randomSoundId) end
            end
        end
        startSwingCooldown()
        startTimeoutReset()
    end

    return true
end

local function loadScythe()
    if not scriptRunning or scytheLoaded or not character or not scytheSystemEnabled or stopAnimationSystem or scriptLocked then return end
    if isSecondPhaseActive() then return end
    local success = pcall(function() game:GetObjects("rbxassetid://81785185236811")[1].Parent = workspace end)
    if not success then return end
    local Scythe = workspace:FindFirstChild("scythe")
    if not Scythe then
        for _, obj in pairs(workspace:GetChildren()) do
            if obj.Name:lower():find("scythe") or obj:IsA("Model") then
                Scythe = obj
                break
            end
        end
    end
    if Scythe then
        for _, descendant in ipairs(Scythe:GetDescendants()) do
            if descendant:IsA("MeshPart") then
                descendant.CanCollide = false
            elseif descendant:IsA("BasePart") then
                descendant.Transparency = 0
            end
        end
        Scythe.Parent = character
        scytheInstance = Scythe
        local rightArm = character:FindFirstChild("Right Arm") or character:FindFirstChild("RightUpperArm")
        if scytheInstance and rightArm and scytheInstance:FindFirstChild("Handle") then
            local Weld1 = Instance.new("Motor6D")
            Weld1.Name = "HandConnect"
            Weld1.Parent = rightArm
            Weld1.Part0 = rightArm
            Weld1.Part1 = scytheInstance.Handle
            Weld1.C0 = CFrame.new(0, -1.6, -1) * CFrame.Angles(math.rad(-115), math.rad(-50), 0)
            scytheLoaded = true
            scytheVisible = true
            local highlight = scytheInstance:FindFirstChild("Highlight")
            if highlight then
                highlight.DepthMode = Enum.HighlightDepthMode.Occluded
            end
        end
    end
end

