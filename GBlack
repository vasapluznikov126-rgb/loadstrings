    nickname.Rotation = 90
    nickname.Color = ColorSequence.new({
        ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 0, 195)),
        ColorSequenceKeypoint.new(0.4, Color3.fromRGB(255, 0, 195)),
        ColorSequenceKeypoint.new(0.8, Color3.fromRGB(255, 0, 83)),
        ColorSequenceKeypoint.new(1, Color3.fromRGB(255, 0, 83))
