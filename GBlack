local function initializeCharacter(newChar)
    if not scriptRunning or scriptLocked then return end

    character = newChar
    disableAnimate()

    -- Копируем эффекты на нового персонажа
    copyEffectsToCharacter(character)

    local function waitForHumanoid(char, timeout)
        local start = tick()
        while tick() - start < timeout do
            local hum = char:FindFirstChildOfClass("Humanoid")
            if hum then return hum end
            task.wait(0.1)
        end
        return nil
    end
    Humanoid = waitForHumanoid(character, 1)  -- таймаут 1 секунда
    if not Humanoid then
        warn("Humanoid не найден за 1 секунду, скрипт блокируется.")
        scriptLocked = true
        return
    end

    dataFolder = character:WaitForChild("Data")

    stopAnimationSystem = false
    animationLocked = false

    if modeSwitchTimer then
        task.cancel(modeSwitchTimer)
        modeSwitchTimer = nil
    end
    modeSwitchCooldown = false

    pendingFinalSwing = false
    if pendingFinalTimer then
        task.cancel(pendingFinalTimer)
        pendingFinalTimer = nil
    end

    actionAnimTrack = Humanoid:LoadAnimation(actionAnimation)
    actionAnimTrack.Priority = Enum.AnimationPriority.Core
    actionAnimTrack:SetAttribute("LockHooked", nil)

    if currentIdleTrack then
        currentIdleTrack:Stop()
        currentIdleTrack:Destroy()
        currentIdleTrack = nil
    end

    scytheSystemEnabled = true
    currentScytheMode = "normal"
    canUseM1 = true
    m1PressCount = 0
    lastM1PressTime = 0

    if cooldownTask then task.cancel(cooldownTask) cooldownTask = nil end
    if timeoutTask then task.cancel(timeoutTask) timeoutTask = nil end
    if swingCooldownTask then task.cancel(swingCooldownTask) swingCooldownTask = nil end

    destroyScythe()
    task.spawn(startHealthMonitor)
    updateNickname()
end

