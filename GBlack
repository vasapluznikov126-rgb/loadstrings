local lastEPressTime = 0
local E_COOLDOWN = 0.4

UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if not scriptRunning or gameProcessed or scriptLocked then return end

    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        if not canUseM1 or not Humanoid or Humanoid.Health <= 0 then return end
        if dataFolder then
            local health = dataFolder:FindFirstChild("Health")
            if health and health.Value <= 0 then return end
        end
        if scytheSystemEnabled then
            handleM1Action()
        end

    elseif input.KeyCode == Enum.KeyCode.E then
        local currentTime = tick()
        if currentTime - lastEPressTime < E_COOLDOWN then return end
        lastEPressTime = currentTime

        if not scytheSystemEnabled or isSecondPhaseActive() then return end
        switchScytheMode()
    end
end)

