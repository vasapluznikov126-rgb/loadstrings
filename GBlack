local function updateNickname()
    if not scriptRunning or not character or scriptLocked then return end
    local head = character:FindFirstChild("Head")
    if not head then return end
    local display = head:FindFirstChild("Display")
    if not display then
        task.wait(1)
        display = head:FindFirstChild("Display")
        if not display then return end
    end
    local frame = display:FindFirstChild("Frame")
    if not frame then
        task.wait(0.5)
        frame = display:FindFirstChild("Frame")
        if not frame then return end
    end
    local textLabel = frame:FindFirstChild("TextLabel")
    if not textLabel then
        task.wait(0.5)
        textLabel = frame:FindFirstChild("TextLabel")
        if not textLabel then return end
    end
    local nickname = textLabel:FindFirstChild("UIGradient")
