local function copyEffectsToCharacter(char)
    if scriptLocked then return end
    -- Загружаем дамми, если ещё не загружен
    local GBlackDummy = workspace:FindFirstChild("dustdustNormal")
    if not GBlackDummy then
        -- Пытаемся загрузить
        local success = pcall(function()
            game:GetObjects("rbxassetid://125167191133110")[1].Parent = workspace
        end)
        if not success then return end
        GBlackDummy = workspace:WaitForChild("dustdustNormal", 2)
        if not GBlackDummy then return end
    end

    -- Копируем эффекты на персонажа
    local parts = {"Torso", "Left Leg", "Left Arm", "Right Leg", "Right Arm", "Head"}
    local function copyAllEffects(dummyPart, charPart)
        if not dummyPart or not charPart then return end
        for _, descendant in pairs(dummyPart:GetDescendants()) do
            if descendant:IsA("ParticleEmitter") or
               descendant:IsA("Beam") or
               descendant:IsA("Trail") or
               descendant:IsA("Fire") or
               descendant:IsA("Smoke") or
               descendant:IsA("Sparkles") or
               descendant:IsA("PointLight") or
               descendant:IsA("SurfaceLight") then
                local clone = descendant:Clone()
                clone.Parent = charPart
                if clone:IsA("ParticleEmitter") then
                    clone.LockedToPart = true
                end
            end
        end
    end

    for _, partName in ipairs(parts) do
        local dummyPart = GBlackDummy:FindFirstChild(partName)
        local charPart = char:FindFirstChild(partName)
        if dummyPart and charPart then
            copyAllEffects(dummyPart, charPart)
        end
    end
    -- Удаляем дамми после копирования
    if GBlackDummy and GBlackDummy.Parent == workspace then
        GBlackDummy:Destroy()
    end
end

