-- Function to create a console loading bar
local function createLoadingBar(totalItems, title)
    -- Check if console functions exist
    local hasConsole = pcall(function()
        return rconsolecreate and rconsoleinput and rconsoleprint
    end)
    
    if not hasConsole then
        print("Console not available!")
        return {
            update = function() end,
            loaded = function() end,
            complete = function() print("UI Loaded!") end,
            error = function(msg) print("Error: " .. msg) end
        }
    end
    
    rconsolesettitle(title)
    rconsolecreate()
    rconsoleclear()
    
    local current = 0
    local barLength = 30
    
    local function updateProgress(itemName, isComplete)
        current = current + 1
        local percentage = (current / totalItems) * 100
        local filled = math.floor((percentage / 100) * barLength)
        local empty = barLength - filled
        
        -- Use ONLY basic ASCII characters that work everywhere cuz it breakes my gui bruh
        local bar = "[" .. string.rep("#", filled) .. string.rep("-", empty) .. "]"
        local status = isComplete and "[OK]" or "[..]"
        
        rconsoleclear()
        rconsoleprint("=== " .. title .. " ===\n\n")
        rconsoleprint("Loading: " .. itemName .. "\n\n")
        rconsoleprint("Progress: " .. bar .. " " .. string.format("%.1f", percentage) .. "%\n")
        rconsoleprint("(" .. current .. "/" .. totalItems .. " completed)\n\n")
        
        if isComplete then
            rconsoleprint("Status: " .. status .. " Complete!\n")
        else
            rconsoleprint("Status: " .. status .. " Loading...\n")
        end
    end
    
    return {
        update = updateProgress,
        loaded = function(itemName, success, errorMsg)
            if success then
                updateProgress(itemName, true)
            else
                rconsoleclear()
                rconsoleprint("=== " .. title .. " ===\n\n")
                rconsoleprint("[ERROR] loading: " .. itemName .. "\n")
                rconsoleprint("Error: " .. tostring(errorMsg) .. "\n\n")
                rconsoleprint("Continuing...\n")
                task.wait(1)
                updateProgress(itemName, false)
            end
        end,
        complete = function()
            rconsoleclear()
            rconsoleprint("=== " .. title .. " ===\n\n")
            rconsoleprint("[SUCCESS] UI LOADED\n\n")
            rconsoleprint("Total steps completed: " .. totalItems .. "\n")
            rconsoleprint("Enjoy the gui my Master\n")
            task.wait(1.5)
            rconsoledestroy()
        end,
        error = function(msg)
            rconsoleclear()
            rconsoleprint("=== " .. title .. " ===\n\n")
            rconsoleprint("[FATAL ERROR] " .. msg .. "\n")
            rconsoleprint("Please check your internet connection and try again.\n")
        end
    }
end

